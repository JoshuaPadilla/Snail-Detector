{
	"expo": {
		"name": "PinkSnailEggs",
		"slug": "Snail-Detector",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/pinksnail-icon.png",
		"scheme": "snaildetector",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"infoPlist": {
				"NSCameraUsageDescription": "Snail Detector needs access to your camera to scan water surfaces for snail egg clusters.",
				"NSPhotoLibraryUsageDescription": "Snail Detector needs access to your photo library to inspect saved photos for snail egg clusters."
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#071A2B",
				"foregroundImage": "./assets/images/pinksnail-adaptive-foreground.png",
				"monochromeImage": "./assets/images/pinksnail-adaptive-monochrome.png"
			},
			"permissions": ["android.permission.CAMERA"],
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"package": "com.joshua129.SnailDetector"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/pinksnail-icon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-image-picker",
				{
					"cameraPermission": "Snail Detector can use your camera to scan water surfaces for snail egg clusters.",
					"microphonePermission": false,
					"photosPermission": "Snail Detector needs access to your photo library to inspect saved photos for snail egg clusters."
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/pinksnail-splash.png",
					"imageWidth": 240,
					"resizeMode": "contain",
					"backgroundColor": "#071A2B",
					"dark": {
						"backgroundColor": "#071A2B"
					}
				}
			],
			"react-native-fast-tflite"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
